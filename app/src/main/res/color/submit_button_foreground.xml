<?xml version="1.0" encoding="utf-8"?>
<!--
    ColorStateList para el texto e icono del botón "Entregar tarea".
    - Habilitado: blanco (texto_boton).
    - Deshabilitado: gris atenuado (texto_principal + alpha).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.38"
        android:color="@color/texto_principal"
        android:state_enabled="false" />
    <item android:color="@color/texto_boton" />
</selector>