<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MiMoodleAndalucia" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colores primarios basados en tu paleta -->
        <item name="colorPrimary">@color/color_acento</item>
        <item name="colorPrimaryVariant">@color/color_acento_presionado</item>
        <item name="colorOnPrimary">@color/texto_boton</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/color_acento</item>
        <item name="colorSecondaryVariant">@color/color_acento_presionado</item>
        <item name="colorOnSecondary">@color/texto_boton</item>

        <!-- Atributos de paleta (permiten cambiar el acento en runtime) -->
        <item name="appAccent">@color/color_acento</item>
        <item name="appAccentPressed">@color/color_acento_presionado</item>
        <item name="appAccentSoft">@color/verde_junta_suave</item>

        <!-- Contenedores (para fondos decorativos como el del login) -->
        <item name="colorPrimaryContainer">@color/verde_junta_suave</item>
        <item name="colorSecondaryContainer">@color/verde_junta_suave</item>

        <!-- Fondo general -->
        <item name="android:windowBackground">@color/fondo_app</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Estilos personalizados para los Chips (Material 2) -->
        <item name="chipBackgroundColor">@color/verde_junta_suave</item>
        <item name="chipStrokeColor">@color/color_acento</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconTint">@color/color_acento</item>
        <!-- Colores del fondo de login (paleta Verde) -->
        <item name="loginBgEdge">@color/login_green_bg_edge</item>
        <item name="loginBgCenter">@color/login_green_bg_center</item>
        <item name="loginAccentHighlight">@color/login_green_accent_highlight</item>
        <item name="loginAccentPrimary">@color/login_green_accent_primary</item>
        <item name="loginAccentMidLight">@color/login_green_accent_mid_light</item>
        <item name="loginAccentMid">@color/login_green_accent_mid</item>
        <item name="loginAccentMidDark">@color/login_green_accent_mid_dark</item>
        <item name="loginAccentDark">@color/login_green_accent_dark</item>
        <item name="loginAccentDeep">@color/login_green_accent_deep</item>
        <item name="loginGlowStrong">@color/login_green_glow_strong</item>
        <item name="loginGlowSoft">@color/login_green_glow_soft</item>
        <item name="loginRimStart">@color/login_rim_start</item>
        <item name="loginRimCenter">@color/login_green_rim_center</item>
        <item name="loginRimEnd">@color/login_green_rim_end</item>
        <item name="loginLineAccent">@color/login_green_line_accent</item>
        <item name="loginShadow">@color/login_shadow</item>
        <item name="loginTransparent">@color/login_transparent</item>
</style>

    <dimen name="update_dialog_corner_radius">20dp</dimen>

