<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo adaptable al tema -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/loginBgEdge"
                android:centerColor="?attr/loginBgCenter"
                android:endColor="?attr/loginBgEdge"
                android:type="linear" />
        </shape>
    </item>

    <!-- Esquina superior izquierda sin deformación -->
    <item
        android:drawable="@drawable/bg_login_top_left"
        android:gravity="top|start" />

    <!-- Esquina inferior derecha sin deformación -->
    <item
        android:drawable="@drawable/bg_login_bottom_right"
        android:gravity="bottom|end" />

</layer-list>
