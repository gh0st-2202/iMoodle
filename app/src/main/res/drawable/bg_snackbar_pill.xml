<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de las tarjetas de aviso: pastilla oscura con borde del acento
     de la paleta activa (?attr/loginAccentPrimary). Se usa junto con
     layout_custom_snackbar.xml desde SnackbarExtensions. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E1E1E" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/loginAccentPrimary" />
</shape>
