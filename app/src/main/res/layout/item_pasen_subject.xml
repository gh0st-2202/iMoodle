<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_subject_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto_principal"
            android:textSize="15sp"
            tools:text="Acceso a datos" />

        <TextView
            android:id="@+id/txt_subject_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/appAccent"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="8,5" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_subject_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/texto_hint"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Media de la clase: 7,2" />

</LinearLayout>
