<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/fondo_input"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/borde_input"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Franja de color determinista a la izquierda -->
        <View
            android:id="@+id/colorIndicator"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="@color/schedule_color_0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Rango de hora -->
            <TextView
                android:id="@+id/txtTimeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_acento"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="08:30 - 09:30" />

            <!-- Nombre de la asignatura -->
            <TextView
                android:id="@+id/txtSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Programación de servicios y procesos" />

            <!-- Nombre del profesor -->
            <TextView
                android:id="@+id/txtProfessor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/texto_hint"
                android:textSize="14sp"
                tools:text="Prof. Samuel Mendivil Martínez" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>