<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/fondo_input"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/borde_input"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_post_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_acento"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Juan Pérez" />

        <TextView
            android:id="@+id/txt_post_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_hint"
            android:textSize="12sp"
            tools:text="12/10/2026 18:30" />

        <!-- 🛠️ Añadido autoLink, textColorLink y lineSpacing para mejor lectura -->
        <TextView
            android:id="@+id/txt_post_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autoLink="web"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/texto_principal"
            android:textColorLink="@color/color_acento"
            android:textSize="15sp"
            tools:text="Este es el contenido del mensaje..." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>