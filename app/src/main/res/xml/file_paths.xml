<?xml version="1.0" encoding="utf-8"?>
<!--
    Define las rutas desde las que la app puede compartir archivos con
    otras apps (aquí, solo con el instalador de paquetes del sistema).

    Se expone únicamente la subcarpeta "updates" de la caché, donde se
    guarda el APK descargado, y no toda la caché de la app. La caché es
    temporal: el sistema puede borrarla si necesita espacio.
-->
<paths>
    <cache-path name="apk_updates" path="updates/" />
</paths>
